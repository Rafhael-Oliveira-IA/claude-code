# ── Provider: openai ──────────────────────────────────────────
# Uses the local Bun proxy (proxy.js) which translates
# Anthropic protocol → OpenAI API.
# Start the proxy first: .\run.ps1 proxy
# ──────────────────────────────────────────────────────────────

ANTHROPIC_BASE_URL=http://127.0.0.1:4000
ANTHROPIC_API_KEY=sk-local
ANTHROPIC_MODEL=gpt-4o
ANTHROPIC_SMALL_FAST_MODEL=gpt-4o-mini
