# ── Provider: local ───────────────────────────────────────────
# Uses Ollama running on another PC via LiteLLM proxy.
# On the other PC run:
#   ollama serve
#   litellm --model ollama/llama3 --port 4000 --host 0.0.0.0 --drop_params
# ──────────────────────────────────────────────────────────────

# Replace with your other PC's local IP (e.g. 192.168.1.42)
ANTHROPIC_BASE_URL=http://192.168.1.42:4000
ANTHROPIC_API_KEY=sk-local
ANTHROPIC_MODEL=llama3
ANTHROPIC_SMALL_FAST_MODEL=llama3
