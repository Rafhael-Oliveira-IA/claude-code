# ============================================================
# Claude Code — configuração para Llama local (outro PC)
# ============================================================
# Substitua <IP_DO_PC> pelo IP real quando tiver (ex: 192.168.1.42)
#
# Requer LiteLLM rodando no outro PC (veja README abaixo)
# ============================================================

# Endereço do servidor LiteLLM rodando no outro PC
ANTHROPIC_BASE_URL=http://<IP_DO_PC>:4000

# Pode ser qualquer string — o servidor local não valida isso
ANTHROPIC_API_KEY=sk-local

# Modelo que será usado (deve bater com o nome no LiteLLM)
# Ex: llama3, llama3:70b, mistral, etc.
ANTHROPIC_MODEL=llama3

# Modelo rápido/leve (usado para tarefas internas como resumo)
# Pode ser o mesmo modelo ou um menor
ANTHROPIC_SMALL_FAST_MODEL=llama3
